generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
  VENDOR
  CUSTOMER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ContributionStatus {
  PAID
  PENDING
  MISSED
}

enum PayoutStatus {
  PENDING
  COMPLETED
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum WithdrawalStatus {
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CASH
  TRANSFER
  SYSTEM
}

enum ProductKind {
  STANDARD
  PACKAGE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Ajo relations
  groupsOwned    Group[]         @relation("GroupAdmin")
  groupMembers   GroupMember[]
  contributions  Contribution[]
  payouts        Payout[]

  // Vendor relations
  products     Product[]      @relation("VendorProducts")
  productPackages ProductPackage[] @relation("VendorPackages")
  policyTemplates VendorPolicyTemplate[] @relation("VendorPolicyTemplates")
  installments Installment[]  @relation("CustomerInstallments")
  walletWithdrawals WalletWithdrawal[] @relation("VendorWithdrawals")

  auditLogs AuditLog[]

  @@index([email])
}

model Group {
  id                 String    @id @default(cuid())
  name               String
  contributionAmount Decimal   @db.Decimal(14, 2)
  frequency          Frequency
  startDate          DateTime
  totalMembers       Int
  adminId            String
  admin              User      @relation("GroupAdmin", fields: [adminId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  members       GroupMember[]
  contributions Contribution[]
  payouts       Payout[]

  @@index([adminId])
}

model GroupMember {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payoutOrder Int
  joinedAt    DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

model Contribution {
  id        String             @id @default(cuid())
  groupId   String
  group     Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId  String
  member    User               @relation(fields: [memberId], references: [id])
  amount    Decimal            @db.Decimal(14, 2)
  status    ContributionStatus @default(PENDING)
  createdAt DateTime           @default(now())

  @@index([groupId])
  @@index([memberId])
}

model Payout {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId    String
  member      User         @relation(fields: [memberId], references: [id])
  payoutOrder Int
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  @@unique([groupId, payoutOrder])
  @@index([groupId])
}

model Product {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    User     @relation("VendorProducts", fields: [vendorId], references: [id])
  name      String
  price     Decimal  @db.Decimal(14, 2)
  imageUrl  String?
  kind      ProductKind @default(STANDARD)
  createdAt DateTime @default(now())

  installments Installment[]
  packageItems ProductPackageItem[]
  sourcePackage ProductPackage? @relation("PackageProduct")

  @@index([vendorId])
}

model ProductPackage {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    User     @relation("VendorPackages", fields: [vendorId], references: [id])
  name      String
  baseTotal Decimal  @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  finalTotal Decimal @default(0) @db.Decimal(14, 2)
  packageProductId String? @unique
  packageProduct Product? @relation("PackageProduct", fields: [packageProductId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ProductPackageItem[]

  @@index([vendorId])
  @@unique([vendorId, name])
}

model ProductPackageItem {
  id        String         @id @default(cuid())
  packageId String
  package   ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([packageId, productId])
  @@index([productId])
  @@index([packageId])
}

model Installment {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id])
  customerId  String
  customer    User               @relation("CustomerInstallments", fields: [customerId], references: [id])
  totalAmount Decimal            @db.Decimal(14, 2)
  amountPaid  Decimal            @db.Decimal(14, 2) @default(0)
  balance     Decimal            @db.Decimal(14, 2)
  status      InstallmentStatus  @default(ACTIVE)
  policyTemplateId String?
  policyTemplate VendorPolicyTemplate? @relation(fields: [policyTemplateId], references: [id], onDelete: SetNull)
  policyTemplateName String?
  policyTemplateContent String?
  policyAppliedAt DateTime?
  policyAcceptedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  payments Payment[]

  @@index([productId])
  @@index([customerId])
  @@index([policyTemplateId])
}

model VendorPolicyTemplate {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    User     @relation("VendorPolicyTemplates", fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installments Installment[]

  @@index([vendorId])
  @@unique([vendorId, name])
}

model Payment {
  id            String      @id @default(cuid())
  installmentId String
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(14, 2)
  paidAt        DateTime    @default(now())
  method        PaymentMethod @default(SYSTEM)
  reference     String?

  @@index([installmentId])
}

/// Money the vendor moves out of their Kreddt wallet to an external bank account.
/// Wallet balance = lifetime payments received - sum of non-failed withdrawals.
/// Total revenue (lifetime payments received) is never affected by withdrawals.
model WalletWithdrawal {
  id            String           @id @default(cuid())
  vendorId      String
  vendor        User             @relation("VendorWithdrawals", fields: [vendorId], references: [id])
  amount        Decimal          @db.Decimal(14, 2)
  bankName      String
  accountNumber String
  accountName   String?
  status        WithdrawalStatus @default(COMPLETED)
  createdAt     DateTime         @default(now())

  @@index([vendorId])
}

/// Immutable audit trail for all financial actions (contributions, payouts, payments)
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
